# Copy to .env.local for development. Never commit .env files.
#
# v1 runs de-identified: no client names, dates of birth, or addresses are
# stored. See docs/operating-model.md before adding any field that could
# hold an identifier.

# Neon Postgres connection string (free tier is sufficient for v1)
DATABASE_URL=

# Base URL used to build sign-in links
APP_URL=http://localhost:3000

# Email delivery for magic links. Sign-in emails contain no client information.
EMAIL_API_KEY=
EMAIL_FROM=

# Anthropic API key for draft findings (Stage 4).
# Requests are de-identified before they leave the system.
ANTHROPIC_API_KEY=
