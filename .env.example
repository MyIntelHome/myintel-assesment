APP_ORIGIN=https://myintel-assessment-review.aussieg.chatgpt.site
# Set the verified account email of the MyIntel operator in hosting settings.
MYINTEL_ADMIN_EMAIL=
# Optional. Configure only after reviewing the service/payment flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Production adapter candidate. Not used by the private Sites Worker.
# Provision and verify the service before connecting a public backend.
MYINTEL_DATABASE_URL=
MYINTEL_DATABASE_AUTH_TOKEN=
MYINTEL_SUPABASE_URL=
MYINTEL_SUPABASE_PUBLISHABLE_KEY=
MYINTEL_SUPABASE_SERVICE_KEY=
MYINTEL_PHOTO_BUCKET=home-photos
# Random 32 bytes encoded as base64. Store as a hosting Secret.
MYINTEL_SESSION_KEY=
# Explicit migration target confirmation; never needed during app requests/builds.
MYINTEL_MIGRATION_TARGET=

# Lead-capture preview only. Production delivery is hard-disabled in code.
# These settings must be scoped to feature/plan-capture-2026-10-06 on Vercel.
MYINTEL_LEAD_PREVIEW=false
MYINTEL_EMAIL_PREVIEW=false
RESEND_API_KEY=
MYINTEL_EMAIL_FROM=
MYINTEL_STAFF_NOTIFICATION_EMAIL=info@myintelhome.com
# Explicitly approved test recipients, including the staff notification mailbox.
MYINTEL_PREVIEW_EMAIL_ALLOWLIST=
# Optional Shopify base URL. Blank means no product links or disclosure UI.
SHOP_URL=
